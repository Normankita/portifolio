# Copy this file to .env.local for local development.
# CRA inlines REACT_APP_* vars at build time, so these must also be set
# in Vercel (Project Settings -> Environment Variables) for every
# environment that builds the app: Production, Preview, and Development.

# EmailJS (https://www.emailjs.com/) -- used by the contact form in
# src/components/Contact.tsx. Get these from your EmailJS dashboard.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
